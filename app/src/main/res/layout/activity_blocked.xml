<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️"
        android:textSize="72sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Application bloquée"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:letterSpacing="0.1"/>

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instagram"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tv_block_reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📅 Bloquée selon ton planning"
        android:textColor="@color/accent_blue"
        android:textSize="14sp"
        android:layout_marginTop="12dp"/>

    <!-- Divider -->
    <View
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:background="@color/bg_card2"
        android:layout_marginVertical="32dp"/>

    <!-- Motivational message -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="40dp">

        <TextView
            android:id="@+id/tv_motivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💪 Chaque minute récupérée est une minute investie en toi."
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.5"
            android:textAlignment="center"
            android:padding="24dp"/>

    </androidx.cardview.widget.CardView>

    <!-- Emergency timer (hidden by default) -->
    <TextView
        android:id="@+id/tv_emergency_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_orange"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <!-- Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_go_back"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="← Retourner à l'accueil"
        android:textColor="@color/white"
        android:textSize="16sp"
        style="@style/Widget.MaterialComponents.Button"
        android:backgroundTint="@color/accent_blue"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_emergency"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🚨 Mode urgence (5 min)"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/bg_card2"/>

</LinearLayout>
